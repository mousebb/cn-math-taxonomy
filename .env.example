# 复制成 .env 再填。.env 已被 .gitignore 忽略，不会进仓库。
# 服务端只读这个文件，不写。

# ── 服务 ──
PORT=8787
HOST=127.0.0.1

# ── 模型服务商 ──
# 命名规则：AI_<名字>_KEY / _BASE_URL / _MODEL / _PROTOCOL
# 前端只用名字，换厂商不用改代码。想加一个新的，照抄一段换个名字即可。
AI_DEFAULT=deepseek

AI_DEEPSEEK_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-flash
AI_DEEPSEEK_PROTOCOL=openai

# 例子：以后接通义
# AI_QWEN_KEY=
# AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_QWEN_MODEL=qwen-plus
# AI_QWEN_PROTOCOL=openai

# ── 对话限制 ──
CHAT_PER_MINUTE=12
CHAT_MAX_TOKENS=1600
CHAT_TEMPERATURE=0.4
CHAT_MAX_MESSAGES=24
CHAT_MAX_CHARS=4000

# ── 语音输入（可选）──
# DeepSeek 没有音频接口，所以这里单独接一家 ASR。
# 默认硅基流动 SenseVoice：OpenAI 兼容的 /audio/transcriptions，中文好，目前免费。
# 拿 key：https://cloud.siliconflow.cn/account/ak （需先实名）
# 留空则面板里不显示麦克风按钮，其余功能不受影响。
ASR_ENABLED=1
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
ASR_KEY=
ASR_LANGUAGE=zh
# 单次录音上限 8MB / 60 秒，每分钟最多 20 次
ASR_MAX_BYTES=8388608
ASR_MAX_SECONDS=60
ASR_PER_MINUTE=20

# ── 题库同步 ──
SYNC_ENABLED=1
SYNC_INTERVAL_MIN=360
SYNC_UPSTREAM=https://github.com/xiaoyang111222/cn-math-taxonomy.git
SYNC_BRANCH=main
SYNC_KEEP=3
# 应用更新和回退要带这个令牌；留空则只允许本机操作
SYNC_ADMIN_TOKEN=
# auto：有 python3 就用上游 validate.py 校验，没有就用内置校验
# builtin：强制用内置校验（服务器没装 python 时省掉探测）
SYNC_VALIDATOR=auto
